FROM rust:1.99.0-alpine3.23@sha256:42c2519fdf75d9e34cc61a1aaf34b1a684da9bfd65fe5daefef98d92a801b001 AS builder

RUN apk add --no-cache clang cmake

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY vendor ./vendor
COPY src ./src
COPY crates ./crates
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/build/target,sharing=locked \
    cargo build --locked --release --bins \
    && mkdir -p /build/runtime-bin \
    && cp \
        /build/target/release/mcp-ozon \
        /build/target/release/mcp-ozon-control \
        /build/target/release/position-collector \
        /build/target/release/report-collector \
        /build/target/release/report-worker \
        /build/target/release/wb-automation \
        /build/target/release/ozon-campaign-guard \
        /build/runtime-bin/

FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b AS runtime

ARG MCP_RELEASE_GIT_SHA=unverified
LABEL org.opencontainers.image.revision="${MCP_RELEASE_GIT_SHA}"

RUN apk upgrade --no-cache \
    && addgroup -S -g 10001 automation \
    && adduser -S -D -H -u 10001 -G automation automation \
    && mkdir -p /var/lib/mcp-ozon-legacy \
    && chown automation:automation /var/lib/mcp-ozon-legacy \
    && chmod 0700 /var/lib/mcp-ozon-legacy

COPY --from=builder /build/runtime-bin/wb-automation /usr/local/bin/wb-automation

# mimalloc returns freed pages to the OS at once instead of after its
# default one-second purge delay; see src/lib.rs.
ENV MIMALLOC_PURGE_DELAY=0
USER automation
ENTRYPOINT ["/usr/local/bin/wb-automation"]
