FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

RUN apk upgrade --no-cache \
    && apk add --no-cache squid \
    && mkdir -p /var/cache/squid /var/run/squid /var/log/squid \
    && chown -R squid:squid /var/cache/squid /var/run/squid /var/log/squid

COPY position-monitor/control-write-egress/squid.conf /etc/squid/squid.conf
RUN /usr/sbin/squid -k parse -f /etc/squid/squid.conf

USER squid
ENTRYPOINT ["/usr/sbin/squid", "-N", "-f", "/etc/squid/squid.conf"]
