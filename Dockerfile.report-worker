FROM rust:1.98.0-alpine3.23@sha256:4743b6231029d726d7a0f81d730a7c9f4eff23225a4499c01e275efb5e260235 AS builder

RUN apk add --no-cache clang cmake

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY vendor ./vendor
COPY src ./src
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/build/target,sharing=locked \
    cargo build --locked --release --bins \
    && mkdir -p /build/runtime-bin \
    && cp \
        /build/target/release/mcp-ozon \
        /build/target/release/mcp-ozon-control \
        /build/target/release/position-collector \
        /build/target/release/report-collector \
        /build/target/release/report-worker \
        /build/target/release/wb-automation \
        /build/target/release/ozon-campaign-guard \
        /build/runtime-bin/

FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b AS runtime

ARG MCP_RELEASE_GIT_SHA=unverified
LABEL org.opencontainers.image.revision="${MCP_RELEASE_GIT_SHA}"

RUN apk upgrade --no-cache \
    && addgroup -S -g 10001 reporting \
    && adduser -S -D -H -u 10001 -G reporting reporting \
    && install -d -o reporting -g reporting -m 0700 /var/lib/mcp-ozon/report-artifacts

COPY --from=builder /build/runtime-bin/report-worker /usr/local/bin/report-worker

USER reporting
ENTRYPOINT ["/usr/local/bin/report-worker"]
