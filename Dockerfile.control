FROM rust:1.97.1-alpine3.23@sha256:c4a364ddbf684fe038e6fa6a4f25b30c8dc85247423e0e660676ece0d17be4a2 AS builder

RUN apk add --no-cache clang cmake

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY vendor ./vendor
COPY src ./src
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/build/target,sharing=locked \
    cargo build --locked --release --bin mcp-ozon-control \
    && cp /build/target/release/mcp-ozon-control /build/mcp-ozon-control

FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b AS runtime

RUN apk add --no-cache ca-certificates \
    && addgroup -S -g 10001 mcp \
    && adduser -S -D -H -u 10001 -G mcp mcp

COPY --from=builder /build/mcp-ozon-control /usr/local/bin/mcp-ozon-control
COPY config/access.example.json /etc/mcp-ozon/access.json
COPY config/control-policy.example.json /etc/mcp-ozon/control-policy.json

ENV CONTROL_MCP_TRANSPORT=http \
    CONTROL_MCP_BIND=0.0.0.0:8790 \
    CONTROL_MCP_AUTH_MODE=dev \
    CONTROL_MCP_ACTOR_ID=admin \
    CONTROL_MCP_DEV_ALLOW_NON_LOOPBACK=true \
    CONTROL_MCP_ACCESS_CONFIG=/etc/mcp-ozon/access.json \
    CONTROL_MCP_POLICY=/etc/mcp-ozon/control-policy.json \
    RUST_LOG=mcp_ozon::control=info,rmcp=info

EXPOSE 8790
USER mcp

ENTRYPOINT ["/usr/local/bin/mcp-ozon-control"]
