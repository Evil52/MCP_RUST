<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ofk.mcp-ozon-wb-automation-shadow</string>
  <key>ProgramArguments</key>
  <array>
    <string>__RUNNER__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>MCP_RUNTIME_DIR</key>
    <string>__RUNTIME_DIR__</string>
    <key>WB_AUTOMATION_PROJECT_DIR</key>
    <string>__PROJECT_DIR__</string>
    <key>MCP_WB_AUTOMATION_IMAGE</key>
    <string>__WB_AUTOMATION_IMAGE__</string>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <!-- StartInterval drops any firing whose moment lands while the Mac is
       asleep (launchd.plist: "that interval will be missed"), and also
       drops one if the previous cycle is still running. StartCalendarInterval
       instead starts the job on the next wake, coalescing everything missed
       into a single cycle, so a closed lid no longer silently suspends the
       process that enforces the daily spend cap. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>0</integer></dict>
    <dict><key>Minute</key><integer>5</integer></dict>
    <dict><key>Minute</key><integer>10</integer></dict>
    <dict><key>Minute</key><integer>15</integer></dict>
    <dict><key>Minute</key><integer>20</integer></dict>
    <dict><key>Minute</key><integer>25</integer></dict>
    <dict><key>Minute</key><integer>30</integer></dict>
    <dict><key>Minute</key><integer>35</integer></dict>
    <dict><key>Minute</key><integer>40</integer></dict>
    <dict><key>Minute</key><integer>45</integer></dict>
    <dict><key>Minute</key><integer>50</integer></dict>
    <dict><key>Minute</key><integer>55</integer></dict>
  </array>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/wb-automation-shadow.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/wb-automation-shadow.error.log</string>
</dict>
</plist>
