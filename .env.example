# Текущий Tunnel продолжает работать в режиме dev (режим по умолчанию).
# В этом режиме MCP_ACTOR_ID является доверенной идентичностью экземпляра.
MCP_AUTH_MODE=dev
MCP_ACTOR_ID=
MCP_ACCESS_CONFIG=config/access.json

# В compose.auth.yaml эти значения переопределяются для JWT/Keycloak.
# Для внешнего сервера используйте публичные HTTPS URL, не localhost.
# MCP_JWT_ISSUER=https://auth.example.com/realms/ofk
# MCP_JWT_AUDIENCE=https://mcp.example.com/mcp
# MCP_JWT_REQUIRED_SCOPES=mcp:tools
# MCP_JWT_JWKS_URL=http://keycloak:8080/realms/ofk/protocol/openid-connect/certs
# MCP_PUBLIC_URL=https://mcp.example.com/mcp
# MCP_JWKS_CACHE_TTL_SECONDS=300

# Ozon example store from config/access.example.json.
# Add production stores only to ignored local config/access.json and .env.
EXAMPLE_OZON_CLIENT_ID=replace-with-client-id
EXAMPLE_OZON_API_KEY=
EXAMPLE_OZON_PERFORMANCE_CLIENT_ID=
EXAMPLE_OZON_PERFORMANCE_CLIENT_SECRET=

# Wildberries example account from config/access.example.json.
# Use a token with the minimum read-only categories required by the selected tools.
EXAMPLE_WB_API_TOKEN=

# Локальный Streamable HTTP endpoint: http://127.0.0.1:8787/mcp
MCP_TRANSPORT=http
MCP_BIND=127.0.0.1:8787
MCP_MAX_SESSIONS=256
OZON_API_BASE_URL=https://api-seller.ozon.ru
OZON_REQUEST_TIMEOUT_SECONDS=30

# Экспериментальные read-only контракты Ozon. По умолчанию и в production выключены.
# Включайте только в изолированном canary после contract-тестов; точность preview-схем
# должна быть подтверждена read-only ответами Ozon до переключения рабочего Tunnel.
OZON_POSTINGS_VNEXT=false
OZON_FINANCE_ACCRUALS_PREVIEW=false
RUST_LOG=mcp_ozon=info,rmcp=info
