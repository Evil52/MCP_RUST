# Текущий Tunnel продолжает работать в режиме dev (режим по умолчанию).
# В этом режиме MCP_ACTOR_ID является доверенной идентичностью экземпляра.
MCP_AUTH_MODE=dev
MCP_ACTOR_ID=
MCP_ACCESS_CONFIG=config/access.json

# В compose.auth.yaml эти значения переопределяются для JWT/Keycloak.
# Для внешнего сервера используйте публичные HTTPS URL, не localhost.
# MCP_JWT_ISSUER=https://auth.example.com/realms/ofk
# MCP_JWT_AUDIENCE=ozonofk-mcp
# MCP_JWT_JWKS_URL=http://keycloak:8080/realms/ofk/protocol/openid-connect/certs
# MCP_PUBLIC_URL=https://mcp.example.com/mcp
# MCP_JWKS_CACHE_TTL_SECONDS=300

# Ozon: Фурнитура для дома — Серафимович Диана
OZON_CLIENT_ID=3165034
OZON_API_KEY=

# Ozon: Евромебелькомплект — Рогова Юлия
EUROMEBELKOMPLEKT_OZON_CLIENT_ID=881124
EUROMEBELKOMPLEKT_OZON_API_KEY=

# Ozon: Дом мебельной фурнитуры — Карпова Екатерина
DOM_MEBELNOY_FURNITURY_OZON_CLIENT_ID=380397
DOM_MEBELNOY_FURNITURY_OZON_API_KEY=

# Ozon: ОФК-Комплект — Лаптова Юлия
OFK_KOMPLEKT_OZON_CLIENT_ID=61279
OFK_KOMPLEKT_OZON_API_KEY=

# Ozon: Мебельная фурнитурная компания — Скрипов Артем
MEBELNAYA_FURNITURNAYA_KOMPANIYA_OZON_CLIENT_ID=2544510
MEBELNAYA_FURNITURNAYA_KOMPANIYA_OZON_API_KEY=

# Ozon: Центр мебельной фурнитуры — Кремнев Максим
TSENTR_MEBELNOY_FURNITURY_OZON_CLIENT_ID=184202
TSENTR_MEBELNOY_FURNITURY_OZON_API_KEY=

# Ozon: Мегамаркет — Казакова Наталья
MEGAMARKET_OZON_CLIENT_ID=237281
MEGAMARKET_OZON_API_KEY=

# Локальный Streamable HTTP endpoint: http://127.0.0.1:8787/mcp
MCP_TRANSPORT=http
MCP_BIND=127.0.0.1:8787
OZON_API_BASE_URL=https://api-seller.ozon.ru
OZON_REQUEST_TIMEOUT_SECONDS=30
RUST_LOG=mcp_ozon=info,rmcp=info
